    "schema_version": {
      "const": "0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "att_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "institution": {
      "enum": [
        "pac",
        "iendc",
        "supreme_court",
        "high_court",
        "district_court",
        "constitutional_court",
        "other_court",
        "other_body"
      ]
    },
    "institution_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_type": {
      "enum": [
        "statute",
        "guideline",
        "judgment",
        "pac_settlement",
        "pac_decision",
        "pac_election_review",
        "iendc_review",
        "research",
        "correction"
      ]
